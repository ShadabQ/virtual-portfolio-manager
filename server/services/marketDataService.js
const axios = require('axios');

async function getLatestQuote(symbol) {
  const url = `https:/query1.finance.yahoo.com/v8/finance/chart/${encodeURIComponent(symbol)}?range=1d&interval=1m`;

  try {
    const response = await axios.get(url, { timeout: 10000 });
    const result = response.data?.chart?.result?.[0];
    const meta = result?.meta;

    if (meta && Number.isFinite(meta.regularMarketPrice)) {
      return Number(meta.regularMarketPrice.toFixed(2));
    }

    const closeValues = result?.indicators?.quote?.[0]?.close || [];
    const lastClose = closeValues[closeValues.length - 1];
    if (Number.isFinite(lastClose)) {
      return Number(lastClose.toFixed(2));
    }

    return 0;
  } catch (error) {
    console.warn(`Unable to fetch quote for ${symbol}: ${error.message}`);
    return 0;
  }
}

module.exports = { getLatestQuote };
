function runQuery(sql, params = []) {
  return new Promise((resolve, reject) => {
    db.run(sql, params, function (err) {
      if (err) {
        reject(err);
        return;
      }
      resolve({ id: this.lastID, changes: this.changes });
    });
  });
}

function getQuery(sql, params = []) {
  return new Promise((resolve, reject) => {
    db.get(sql, params, (err, row) => {
      if (err) {
        reject(err);
        return;
      }
      resolve(row);
    });
  });
}

function allQuery(sql, params = []) {
  return new Promise((resolve, reject) => {
    db.all(sql, params, (err, rows) => {
      if (err) {
        reject(err);
        return;
      }
      resolve(rows);
    });
  });
}

async function initDatabase() {
  db.serialize(() => {
    db.run(`
      CREATE TABLE IF NOT EXISTS portfolios (
        id TEXT PRIMARY KEY,
        cash_balance REAL NOT NULL,
        realized_pnl REAL NOT NULL DEFAULT 0,
        created_at TEXT NOT NULL
      )
    `);

    db.run(`
      CREATE TABLE IF NOT EXISTS holdings (
        id TEXT PRIMARY KEY,
        portfolio_id TEXT NOT NULL,
        symbol TEXT NOT NULL,
        quantity INTEGER NOT NULL,
        avg_buy_price REAL NOT NULL,
        created_at TEXT NOT NULL,
        updated_at TEXT NOT NULL,
        UNIQUE(portfolio_id, symbol)
      )
    `);

    db.run(`
      CREATE TABLE IF NOT EXISTS trades (
        id TEXT PRIMARY KEY,
        portfolio_id TEXT NOT NULL,
        symbol TEXT NOT NULL,
        type TEXT NOT NULL,
        quantity INTEGER NOT NULL,
        price REAL NOT NULL,
        total_value REAL NOT NULL,
        created_at TEXT NOT NULL
      )
    `);

    db.run(`
      CREATE TABLE IF NOT EXISTS stock_master (
        symbol TEXT PRIMARY KEY,
        company_name TEXT NOT NULL,
        sector TEXT NOT NULL,
        exchange TEXT NOT NULL
      )
    `);

    STOCK_UNIVERSE.forEach((stock) => {
      db.run(
        `INSERT OR IGNORE INTO stock_master (symbol, company_name, sector, exchange) VALUES (?, ?, ?, 'NSE')`,
        [stock.symbol, stock.name, stock.sector]
      );
    });

    db.run(`
      INSERT OR IGNORE INTO portfolios (id, cash_balance, realized_pnl, created_at)
      VALUES ('default', 1000000, 0, datetime('now'))
    `);
  });

  return Promise.resolve();
}

module.exports = {
  db,
  runQuery,
  getQuery,
  allQuery,
  STOCK_UNIVERSE,
  initDatabase,
};
